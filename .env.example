# =============================================================================
# Investa Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values for your environment.
# For production, generate a proper secret key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# =============================================================================

# Django Core
INVESTA_SECRET_KEY=your-secret-key-here
INVESTA_DEBUG=False
INVESTA_ALLOWED_HOSTS=localhost,127.0.0.1

# CORS (comma-separated origins for your frontend)
INVESTA_CORS_ORIGINS=http://localhost:3000,http://localhost:8081
INVESTA_CORS_ALLOW_ALL=False

# AI / Ollama (optional)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
